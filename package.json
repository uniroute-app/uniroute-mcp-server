  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "uniroute-mcp-server": "src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.js",
    "check": "node --check src/index.js && node --check src/client.js",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uniroute-app/uniroute-mcp-server.git"
  },
  "homepage": "https://uniroute.app/models",
